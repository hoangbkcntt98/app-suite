# Public route prefixes are fixed in next.config.ts.
NEXT_PUBLIC_MANGA_BASE_PATH=/manga-web
NEXT_PUBLIC_LIFEQUEST_BASE_PATH=/lifequest
NEXT_PUBLIC_VIDEO_CREATOR_BASE_PATH=/video-creator

# Shared PostgreSQL connection for Manga Web, LifeQuest, and Video Creator.
# Use PostgreSQL schema "app-suite" for all three apps.
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/app_suite_db?schema=app-suite

# Batch Job Management
BATCH_JOB_MANAGEMENT_TOKEN=replace-with-long-random-secret
BATCH_JOB_DEFAULT_CONFIG=jobs/app-tools/config.json
BATCH_JOB_DB_SCHEMA=
BATCH_JOB_TABLE=batch_management_jobs
BATCH_JOB_RUNS_TABLE=batch_management_runs
BATCH_JOB_PYTHON=jobs/app-tools/.venv/bin/python
BATCH_JOB_LOG_DIR=jobs/jobs/logs/batch-jobs
BATCH_JOB_MAX_WORKERS=3

# Optional Manga crawler settings.
MANGA_IMAGE_STORAGE=/home/opc/manga-storage
MANGA_CRAWLER_JOB=jobs/manga_crawler_jobs.py
MANGA_CRAWLER_JOB_PYTHON=python3
MANGA_CRAWLER_LOG=jobs/manga_crawler.log
MANGA_CRAWLER_PYTHON=jobs/app-tools/.venv/bin/python
MANGA_CRAWLER_SAMPLE_CONFIG=
MANGA_AUTH_COOKIE_SECURE=false

# LifeQuest
LIFEQUEST_JWT_SECRET=replace-with-long-random-secret
LIFEQUEST_COOKIE_SECURE=false
LIFEQUEST_UPLOAD_ROOT=/home/opc/lifequest/public/uploads/music
LIFEQUEST_CRON_SECRET=
LIFEQUEST_NEXT_PUBLIC_VAPID_PUBLIC_KEY=
LIFEQUEST_VAPID_PRIVATE_KEY=
LIFEQUEST_VAPID_SUBJECT=mailto:admin@lifequest.local

# Video Creator
VIDEO_ANKI_DATABASE_URL=
VIDEO_APP_ROOT=./app/video-creator
VIDEO_APP_AUTH_USERNAME=admin
VIDEO_APP_AUTH_PASSWORD=replace-me
VIDEO_APP_AUTH_SECRET=replace-with-long-random-secret
VIDEO_DATA_DIR=/mnt/openclaw-data/openclaw
VIDEO_OUTPUT_DIR=/mnt/openclaw-data/openclaw/outputs
VIDEO_LOG_DIR=/mnt/openclaw-data/openclaw
VIDEO_JLPT_N1_SKILL_DIR=/home/opc/openclaw_skill/jlpt-n1
VIDEO_LLM_BASE_URL=
VIDEO_LLM_API_KEY=
VIDEO_LLM_MODEL=
VIDEO_IMAGE_BASE_URL=
VIDEO_IMAGE_API_KEY=
VIDEO_IMAGE_MODEL=
VIDEO_FACEBOOK_PAGE_ID=
VIDEO_FACEBOOK_PAGE_TOKEN=
VIDEO_YOUTUBE_CLIENT_ID=
VIDEO_YOUTUBE_CLIENT_SECRET=
VIDEO_YOUTUBE_REFRESH_TOKEN=
VIDEO_TTS_PROVIDER=edge
VIDEO_TTS_VOICE=ja-JP-NanamiNeural


# Optional external integrations
MANGA_AI_TRANSLATION_PROVIDER=
MANGA_OPENCLAW_BASE_URL=
MANGA_OPENCLAW_API_KEY=
MANGA_OPENCLAW_MODEL=
MANGA_ROUTER_API_KEY=
MANGA_BEDROCK_REGION=
MANGA_BEDROCK_DEFAULT_MODEL=
MANGA_GOOGLE_DRIVE_OAUTH=
MANGA_GOOGLE_DRIVE_OAUTH_CLIENT_ID=
MANGA_GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=
MANGA_GOOGLE_DRIVE_OAUTH_REFRESH_TOKEN=
MANGA_GOOGLE_SERVICE_ACCOUNT_JSON=
MANGA_GOOGLE_APPLICATION_CREDENTIALS=
MANGA_GOOGLE_DRIVE_FOLDER_ID=
MANGA_ANKI_AI_NOTES_TABLE=anki_word
LIFEQUEST_OPENAI_API_KEY=
LIFEQUEST_OPENAI_API_BASE=
LIFEQUEST_OPENAI_MODEL=
LIFEQUEST_NINE_ROUTER_API_KEY=
LIFEQUEST_NINE_ROUTER_MODEL=
LIFEQUEST_DEEPSEEK_API_KEY=
LIFEQUEST_DEEPSEEK_API_BASE=
LIFEQUEST_DEEPSEEK_MODEL=
LIFEQUEST_NINE_ROUTER_API_BASE=http://127.0.0.1:20128/v1
