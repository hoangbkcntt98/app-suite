{
  "name": "app-suite",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3003",
    "build": "NODE_OPTIONS='--max-old-space-size=4096' next build --webpack && pm2 restart app-suite --update-env",
    "build:limited": "systemd-run --user --scope -p MemoryMax=3G -- npm run build",
    "start": "next start -H 127.0.0.1 -p ${PORT:-3003}",
    "lint": "eslint",
    "db:migrate": "node db/batch-job-management/migrate.mjs"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "bcryptjs": "^3.0.3",
    "busboy": "^1.6.0",
    "googleapis": "^174.0.1",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.23.3",
    "next": "^16.4.2",
    "pg": "^8.22.0",
    "puppeteer-core": "^24.43.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.35.1",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/archiver": "^8.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/busboy": "^1.5.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5"
  }
}
